# アプリケーション
APP_NAME=Secure Download
APP_ENV=production
APP_SECRET_KEY=<ランダム文字列 - python -c "import secrets; print(secrets.token_urlsafe(64))">
APP_DEBUG=false
PORTAL_DOMAIN=download.example.com

# データベース（Azure Database for PostgreSQL Flexible Server）
DATABASE_URL=postgresql+asyncpg://app_user:password@sd-postgres.postgres.database.azure.com:5432/secure_download?ssl=require
DATABASE_URL_SYNC=postgresql://app_user:password@sd-postgres.postgres.database.azure.com:5432/secure_download?sslmode=require

# ファイルストレージ
# "azure_blob" (Azure Blob Storage) or "local" (ローカルディスク)
STORAGE_BACKEND=azure_blob
# ローカルディスク使用時のパス（STORAGE_BACKEND=local の場合のみ）
STORAGE_PATH=/var/secure-download/files
ENCRYPTION_KEY=<Fernet鍵 - python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())">

# Azure Blob Storage
AZURE_STORAGE_CONNECTION_STRING=<Azure Storage Account 接続文字列>
AZURE_STORAGE_CONTAINER_NAME=secure-downloads

# Microsoft Graph API
AZURE_TENANT_ID=<テナントID>
AZURE_CLIENT_ID=<アプリケーションID>
AZURE_CLIENT_SECRET=<クライアントシークレット>
GRAPH_SENDER_EMAIL=noreply@example.com

# Entra ID認証（管理画面用）
ENTRA_CLIENT_ID=<Webアプリ用クライアントID>
ENTRA_CLIENT_SECRET=<Webアプリ用シークレット>
ENTRA_REDIRECT_URI=https://download.example.com/auth/callback
ADMIN_GROUP_ID=<管理者グループのObject ID>

# メール処理
MAX_FILE_SIZE_MB=50
DOWNLOAD_EXPIRY_DAYS=30
MAX_DOWNLOADS=10
AUTH_CODE_EXPIRY_MINUTES=10
AUTH_CODE_MAX_ATTEMPTS=5
SESSION_EXPIRY_DAYS=14
RATE_LIMIT_PER_MINUTE=30

# メール処理用メールボックス（Azure Functions がポーリングする対象）
# Exchange Onlineのメールフロールールで添付付きメールを転送する先
PROCESSING_MAILBOX=process@example.com
MAIL_POLLING_INTERVAL_SECONDS=30

# 監視
TEAMS_WEBHOOK_URL=<Microsoft Teams Incoming Webhook URL>
# Azure Application Insights
APPLICATIONINSIGHTS_CONNECTION_STRING=<Application Insights 接続文字列>
