[Unit]
Description=Secure Download - Mail Handler (Postfix integration)
After=network.target postfix.service secure-download.service
Requires=postfix.service

[Service]
# このサービスはPostfixのpipe transportから呼ばれるため、
# 常駐デーモンではなく、Postfixのmaster.cfで管理される。
# このユニットはPostfixの起動と連携を管理するためのもの。
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/true
ExecStartPost=/usr/sbin/postfix reload

[Install]
WantedBy=multi-user.target
